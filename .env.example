# TravelPlus — copy to .env and fill in. NEVER commit .env (it is gitignored).
# Startup fails with the offending variable named if any of these are invalid.

NODE_ENV=development

# --- Core ------------------------------------------------------------------
DATABASE_URL=postgres://travelplus_app:travelplus@localhost:5432/travelplus
APP_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
ENCRYPTION_KEY=

# --- Routing (OpenTripPlanner) ---------------------------------------------
OTP_BASE_URL=http://localhost:8080
OTP_ROUTER_ID=klang-valley

# --- AI --------------------------------------------------------------------
# AI_PROVIDER=fake is the default and is what CI uses: deterministic, no model,
# no paid API. Switch to ollama for real planning locally.
AI_PROVIDER=fake
# Configurable by URL so native Windows Ollama and a container both work.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Map and geocoding -----------------------------------------------------
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# REQUIRED: provider policy demands a User-Agent identifying the app WITH a real
# contact address. Startup refuses the placeholder below — edit it.
NOMINATIM_USER_AGENT=TravelPlus/0.1 (contact: replace@example.com)
WIKIMEDIA_USER_AGENT=TravelPlus/0.1 (contact: replace@example.com)

# Policy maximum is 1 request/second for the WHOLE application. Do not raise.
NOMINATIM_MAX_RPS=1

# --- Other providers -------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com

LOG_LEVEL=info
